{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "ZPI: Coding session",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/tsx",
      "program": "${workspaceFolder}/examples/coding-session.ts",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "ZPI: Electron main",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/electron",
      "runtimeArgs": ["--remote-debugging-port=9222"],
      "program": "${workspaceFolder}/packages/desktop/dist/main/index.js",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "ZPI: build",
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/desktop/dist/main/**/*.js"],
      "console": "integratedTerminal",
      "env": {
        "ELECTRON_RUN_AS_NODE": null
      }
    }
  ]
}
