{
  "name": "@zpi-dev/agent-sdk",
  "version": "0.1.65",
  "type": "module",
  "description": "TypeScript Agent SDK for ZPI with a Claude-compatible public API",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./host": {
      "development": "./src/host.ts",
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node ../../scripts/build-agent-sdk.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "sharp": "0.35.5",
    "typebox": "1.3.27",
    "openai": "7.19.0",
    "@anthropic-ai/sdk": "0.124.0"
  },
  "devDependencies": {
    "@zpi-dev/ai": "0.1.65",
    "@zpi-dev/agent": "0.1.65",
    "@zpi-dev/coding-agent": "0.1.65",
    "@zpi-dev/plugin-compat": "0.1.65",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1316151417/zpi.git",
    "directory": "packages/agent-sdk"
  },
  "homepage": "http://101.200.240.206/zpi/docs/features/sdk",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
